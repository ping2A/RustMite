# Build context noise — keep the image build lean and cache-friendly.
.git/
.github/
.dev/
.DS_Store
**/.DS_Store
target/
**/target/
models/
docs/
scripts/
examples/
assets/*.psd
**/*.md
!README.md
!docker/share/probes/README.md
docker/ssh-matrix/.keys/
# Keep staged musl probe/loader ELFs for the appliance image.
!docker/share/probes/
!docker/share/probes/**/
# Keep init.sql for the appliance image; omit compose-only files.
docker/clickhouse/docker-compose.yml
docker/clickhouse/**/data/
*.pdb
.env
.env.*
mutants.out*/
**/*.rs.bk
